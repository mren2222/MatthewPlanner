{
  "name": "matthew-planner",
  "productName": "Matthew Planner",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Local-first day and duration planner for Windows",
  "author": "Matthew Ren",
  "license": "UNLICENSED",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "package": "node scripts/build.mjs && electron-builder --win dir",
    "package:portable": "node scripts/build.mjs && electron-builder --win portable",
    "test:e2e": "node scripts/e2e.mjs",
    "test:packaged": "node scripts/e2e.mjs --packaged",
    "test:dev": "node scripts/dev-smoke.mjs"
  },
  "build": {
    "appId": "local.matthew.planner",
    "productName": "Matthew Planner",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "tsdav": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
